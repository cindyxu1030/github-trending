# Copy this file to .env and fill in your values.

# Email recipient for the daily digest.
RECIPIENT_EMAIL=you@example.com

# Path to a script that sends an email. It must accept:
#   --to <address>  --subject <text>  --body-file <path>
# You can use any Python/Node script that talks to your SMTP provider.
# Example: /path/to/send_email.py
SEND_EMAIL_SCRIPT=/path/to/your/send_email.py

# Optional: comma-separated list of interest areas used to rank repos.
INTERESTS=AI/ML, developer tools, frontend, automation

# Optional: Claude model to use.
MODEL=claude-sonnet-4-6

# Optional: override data/log locations.
# DATA_DIR=/custom/path/data
# REPORTS_DIR=/custom/path/data/reports
# SENT_REPOS_FILE=/custom/path/data/sent_repos.md
# LOG_DIR=/custom/path/logs
